PORT=8788
NODE_ENV=production
CODINGVIBES_LINUX_RUNNER_TOKEN=replace-with-long-random-token
CODINGVIBES_LINUX_WORK_ROOT=/var/lib/codingvibes-runner/runs
CODINGVIBES_LINUX_MAX_BYTES=104857600
CODINGVIBES_LINUX_MAX_FILES=6000
CODINGVIBES_LINUX_JOB_TIMEOUT_MS=1200000
CODINGVIBES_LINUX_MAX_CONCURRENCY=1
CODINGVIBES_DEPENDENCY_NETWORK=codingvibes-deps-production
CODINGVIBES_ANDROID_RUNNER_IMAGE=ghcr.io/codingvibes/runner-android@sha256:REPLACE
CODINGVIBES_FLUTTER_RUNNER_IMAGE=ghcr.io/codingvibes/runner-flutter@sha256:REPLACE
CODINGVIBES_RUST_RUNNER_IMAGE=ghcr.io/codingvibes/runner-rust@sha256:REPLACE
CODINGVIBES_ARTIFACT_UPLOAD_URL=https://artifact.example/upload
CODINGVIBES_ARTIFACT_UPLOAD_TOKEN=replace-with-artifact-service-token
