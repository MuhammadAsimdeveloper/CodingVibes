[Unit]
Description=codingVibes Linux runner daemon
After=docker.service
Requires=docker.service

[Service]
Type=simple
User=codingvibes-runner
Group=docker
WorkingDirectory=/opt/codingvibes-runner
EnvironmentFile=/etc/codingvibes/linux-runner.env
ExecStart=/usr/bin/node /opt/codingvibes-runner/server.mjs
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/codingvibes-runner

[Install]
WantedBy=multi-user.target
