# Build Vibe production launch contract
NODE_ENV=production
HOST=0.0.0.0
PORT=4400
CODINGVIBES_PUBLIC_URL=https://your-domain.example
# Optional Bing/IndexNow freshness notifications for published public URLs.
CODINGVIBES_INDEXNOW_KEY=
CODINGVIBES_INDEXNOW_KEY_LOCATION=
CODINGVIBES_GOOGLE_SITE_VERIFICATION=
CODINGVIBES_BING_SITE_VERIFICATION=
CODINGVIBES_ALLOWED_ORIGINS=https://your-domain.example
CODINGVIBES_TRUST_PROXY=false
CODINGVIBES_SESSION_SECRET=replace-with-a-64+-character-random-secret
CODINGVIBES_RUNTIME=daytona
DAYTONA_API_KEY=
DATABASE_PATH=./data/codingvibes.db
CODINGVIBES_PROJECT_ROOT=./data/projects
CODINGVIBES_WORK_ROOT=./data/worktrees
CODINGVIBES_CHECKPOINT_ROOT=./data/checkpoints
CODINGVIBES_BACKUP_ROOT=./data/backups
CODINGVIBES_ENABLE_BROWSER=true
CODINGVIBES_ENFORCE_QUOTAS=true
CODINGVIBES_BILLING_REQUIRED=true
CODINGVIBES_PROVIDER=openai
CODINGVIBES_RESEARCH_API_URL=
CODINGVIBES_RESEARCH_API_KEY=
CODINGVIBES_RESEARCH_PROVIDER=
CODINGVIBES_CLOUD_API_URL=
CODINGVIBES_CLOUD_API_KEY=
CODINGVIBES_HOSTING_API_URL=
CODINGVIBES_HOSTING_API_KEY=
OPENAI_API_KEY=
CODINGVIBES_MODEL_STANDARD=
CODINGVIBES_MODEL_PREMIUM=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_TEAM_MONTHLY=
CODINGVIBES_SUPERADMIN_EMAILS=
GITHUB_TOKEN=
VERCEL_TOKEN=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
CLOUDFLARE_API_TOKEN=
RUNWAYML_API_SECRET=

# Optional horizontal-scale foundation. Keep false/local until these services are provisioned and integrated.
CODINGVIBES_SCALEOUT_REQUIRED=false
CODINGVIBES_DB_BACKEND=sqlite
CODINGVIBES_OBJECT_BACKEND=local
CODINGVIBES_OBJECT_BUCKET=
CODINGVIBES_OBJECT_REGION=us-east-1
CODINGVIBES_OBJECT_ENDPOINT=
CODINGVIBES_REDIS_URL=
CODINGVIBES_QUEUE_BACKEND=local
CODINGVIBES_PG_SSL_MODE=require
CODINGVIBES_PG_POOL_MAX=20
