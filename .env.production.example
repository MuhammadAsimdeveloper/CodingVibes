# Build Vibe production launch contract
NODE_ENV=production
HOST=0.0.0.0
PORT=4400
CODINGVIBES_PUBLIC_URL=https://your-domain.example
CODINGVIBES_SESSION_SECRET=replace-with-a-64+-character-random-secret
CODINGVIBES_RUNTIME=daytona
DAYTONA_API_KEY=
DATABASE_PATH=./data/codingvibes.db
CODINGVIBES_PROJECT_ROOT=./data/projects
CODINGVIBES_WORK_ROOT=./data/worktrees
CODINGVIBES_CHECKPOINT_ROOT=./data/checkpoints
CODINGVIBES_BACKUP_ROOT=./data/backups
CODINGVIBES_ENABLE_BROWSER=true
CODINGVIBES_ENFORCE_QUOTAS=true
CODINGVIBES_BILLING_REQUIRED=true
CODINGVIBES_PROVIDER=openai
OPENAI_API_KEY=
CODINGVIBES_MODEL_STANDARD=
CODINGVIBES_MODEL_PREMIUM=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_TEAM_MONTHLY=
CODINGVIBES_SUPERADMIN_EMAILS=
GITHUB_TOKEN=
VERCEL_TOKEN=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
CLOUDFLARE_API_TOKEN=
RUNWAYML_API_SECRET=
