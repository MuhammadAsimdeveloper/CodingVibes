# Optional scale-out adapters. Keep the existing SQLite/local defaults for development.
CODINGVIBES_DB_BACKEND=postgres
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
CODINGVIBES_PG_SSL_MODE=require
CODINGVIBES_PG_POOL_MAX=20
CODINGVIBES_PG_CONNECTION_TIMEOUT_MS=5000
CODINGVIBES_PG_IDLE_TIMEOUT_MS=30000

CODINGVIBES_OBJECT_BACKEND=s3
CODINGVIBES_OBJECT_BUCKET=
CODINGVIBES_OBJECT_REGION=us-east-1
CODINGVIBES_OBJECT_ENDPOINT=
CODINGVIBES_OBJECT_MAX_BYTES=524288000
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

CODINGVIBES_QUEUE_BACKEND=redis
CODINGVIBES_REDIS_URL=redis://USER:PASSWORD@HOST:6379
