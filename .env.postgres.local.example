# Laptop-only PostgreSQL profile for Build Vibe
# 1) npm run db:postgres:up
# 2) copy this file to .env.postgres.local
# 3) npm run db:postgres:setup
# 4) npm run db:postgres:doctor
DATABASE_URL=postgresql://buildvibe:buildvibe_dev_password@127.0.0.1:5432/buildvibe
CODINGVIBES_DB_BACKEND=postgres
CODINGVIBES_PG_SSL_MODE=disable
CODINGVIBES_PG_POOL_MAX=10
