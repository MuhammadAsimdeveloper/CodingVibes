NODE_ENV=development
HOST=127.0.0.1
PORT=4400
DATABASE_PATH=./data/codingvibes.db
CODINGVIBES_SESSION_SECRET=replace-with-a-long-random-secret
CODINGVIBES_PROVIDER=openai
CODINGVIBES_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
CODINGVIBES_MODEL_CHEAP=gpt-4o-mini
CODINGVIBES_MODEL_STANDARD=gpt-4o-mini
CODINGVIBES_MODEL_PREMIUM=gpt-4.1
CODINGVIBES_BASE_URL=https://api.openai.com/v1
CODINGVIBES_PROVIDER_CHAIN=omniroute,openrouter,openai
CODINGVIBES_MODEL_PROFILES={}

# AI connectors
OMNIROUTE_API_KEY=
CODINGVIBES_OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
CEREBRAS_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
CODINGVIBES_CUSTOM_API_KEY=
CODINGVIBES_CUSTOM_BASE_URL=
CODINGVIBES_PROJECT_ROOT=./data/projects
CODINGVIBES_WORK_ROOT=./data/worktrees
CODINGVIBES_MAX_BODY_BYTES=2097152
CODINGVIBES_ENABLE_BROWSER=true
CODINGVIBES_CAPTURE_SCREENSHOTS=false
CODINGVIBES_RUNTIME=
CODINGVIBES_ALLOW_HOST_EXECUTION=false
CODINGVIBES_CONTAINER_IMAGE=node:22-bookworm-slim
DAYTONA_API_KEY=
DAYTONA_API_URL=
DAYTONA_TARGET=
CODINGVIBES_DAYTONA_PORT=4300
CODINGVIBES_CHECKPOINT_ROOT=./data/checkpoints

# Reliability, review, usage
CODINGVIBES_PROVIDER_COOLDOWN_MS=15000
CODINGVIBES_AI_REVIEW=false
CODINGVIBES_ENFORCE_QUOTAS=false
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_TEAM_MONTHLY=
CODINGVIBES_MODEL_PRICING_JSON={}
CODINGVIBES_RUNNER_LEASE_TIMEOUT_MS=30000

# Integration connectors
GITHUB_TOKEN=
VERCEL_TOKEN=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
CLOUDFLARE_API_TOKEN=
STRIPE_SECRET_KEY=
SENTRY_AUTH_TOKEN=
NEON_API_KEY=
SLACK_BOT_TOKEN=

# Runner fleet hardening
CODINGVIBES_TARGET_RUNNER_MODE=disabled
CODINGVIBES_DEPENDENCY_NETWORK=
CODINGVIBES_ENABLE_DEP_CACHE=false
CODINGVIBES_REQUIRE_PINNED_IMAGES=true
CODINGVIBES_ALLOW_CUSTOM_RUNNER_IMAGES=false
CODINGVIBES_ARTIFACT_MAX_BYTES=524288000
CODINGVIBES_ARTIFACT_UPLOAD_TIMEOUT_MS=60000
CODINGVIBES_MACOS_RUNNER_URL=
CODINGVIBES_MACOS_RUNNER_TOKEN=
CODINGVIBES_MACOS_EPHEMERAL=false
CODINGVIBES_MACOS_MAX_CONCURRENCY=1
CODINGVIBES_MACOS_MAX_BYTES=52428800
CODINGVIBES_MACOS_MAX_FILES=3000
CODINGVIBES_IOS_SCHEME=CodingVibesApp
CODINGVIBES_ANDROID_DEVICE=false
CODINGVIBES_ANDROID_DEVICE_SERIAL=

CODINGVIBES_LINUX_RUNNER_URL=
CODINGVIBES_LINUX_RUNNER_TOKEN=
CODINGVIBES_LINUX_REQUEST_TIMEOUT_MS=1500000
CODINGVIBES_RUNNER_CONTROL_TOKEN=
CODINGVIBES_RUNNER_STALE_MS=120000

# Existing-code workflow
CODINGVIBES_GITHUB_CLONE_TIMEOUT_MS=180000
